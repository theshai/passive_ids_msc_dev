{
  "name": "Python Dev Container",
  "build": {
    "dockerfile": "../Dockerfile"
  },
   "workspaceFolder": "/workspace",

  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind"
  ],

  "forwardPorts": [5000, 8000],
   "overrideCommand": false
}